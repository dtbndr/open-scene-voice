{
  "name": "scenevoice-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-guide.mjs && vite build",
    "check": "node scripts/build-guide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:security": "node scripts/check-security.mjs",
    "test": "vitest run",
    "dev:server": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "svelte": "5.59.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
